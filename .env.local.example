# 브라우저 → Next BFF (같은 오리진이면 비워 둠)
NEXT_PUBLIC_BFF_BASE_URL=

# 앱 공개 URL (OAuth redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Next 서버 → Spring
SPRING_BASE_URL=http://localhost:9377

# Google OAuth (Authorization Code)
# GCP 콘솔 OAuth 2.0 웹 클라이언트 ID/시크릿
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth (REST API 키 = client_id, Client Secret 활성화 시 필수)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
